{
  "name": "@corporate-knowledge/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Local agent memory for durable agent sessions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "bin": {
    "ytk-memory-mcp": "./dist/mcp-server.js",
    "ytk-memory-init": "./dist/agent-memory-init.js",
    "ytk-memory-admin": "./dist/agent-memory-admin.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "demo:agent-memory": "npm run build && node scripts/agent-memory-demo.mjs",
    "start:mcp": "npm run build && node dist/mcp-server.js",
    "pack:check": "npm pack --dry-run",
    "package:check": "node scripts/package-contract-check.mjs",
    "release:check": "node scripts/release-contract-check.mjs",
    "test:maintenance-smoke": "npm run build && node scripts/agent-memory-maintenance-smoke.mjs",
    "test:mcp-smoke": "npm run build && node scripts/agent-memory-mcp-smoke.mjs",
    "test:agent-memory-conformance": "npm run build && node scripts/agent-memory-conformance.mjs",
    "test:agent-memory-conformance-adapter": "npm run build && node scripts/agent-memory-conformance-adapter-smoke.mjs",
    "test:agent-memory-go-conformance": "npm run build && node scripts/agent-memory-go-conformance.mjs",
    "test:agent-memory-go-surface": "node scripts/agent-memory-go-surface.mjs",
    "test:agent-memory-go-setup": "node scripts/agent-memory-go-setup.mjs",
    "test:agent-memory-go-release": "node scripts/agent-memory-go-release.mjs",
    "release:native": "node scripts/agent-memory-go-release.mjs",
    "release:internal": "npm run release:check && npm run package:check && npm run build && node -e \"require('fs').mkdirSync('artifacts', { recursive: true })\" && npm pack --pack-destination artifacts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check . --end-of-line auto",
    "format:write": "prettier --write . --end-of-line auto",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  }
}
