{
  "name": "@corporate-knowledge/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Corporate knowledge platform with local agent memory and document retrieval.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "demo:agent-memory": "npm run build && node scripts/agent-memory-demo.mjs",
    "pack:check": "npm pack --dry-run",
    "package:check": "node scripts/package-contract-check.mjs",
    "test:consumer": "npm run build && node scripts/consumer-smoke.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:context-evaluation": "vitest run test/application/context-evaluation.test.ts",
    "test:embedding-benchmark": "vitest run test/infrastructure/embedding-benchmark.integration.test.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
