{
  "version": 1,
  "mcp": {
    "tools": [
      "memory_get",
      "memory_save",
      "memory_search",
      "memory_session_finish",
      "memory_session_start"
    ],
    "projectIsolation": true
  },
  "maintenance": {
    "doctorHealthy": true,
    "upgradeSchema": "current",
    "rollbackRequiresConfirmation": true
  },
  "installer": {
    "agent": "codex",
    "instructionScope": "local",
    "managedFiles": [
      ".ytk-memory.json",
      ".codex/config.toml",
      ".ytk-memory/YTK-MEMORY.md"
    ]
  }
}
