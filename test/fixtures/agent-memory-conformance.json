{
  "version": 1,
  "clock": "2026-01-15T12:00:00.000Z",
  "operations": [
    {
      "id": "main-session",
      "op": "startSession",
      "workspaceId": "workspace-a",
      "ownerId": "agent-a"
    },
    {
      "id": "auth",
      "op": "save",
      "workspaceId": "workspace-a",
      "sessionId": "$session.main-session",
      "type": "decision",
      "title": "Checkout authentication",
      "content": "The checkout uses the approved authentication model.",
      "subjectKey": "architecture/checkout/authentication",
      "tags": ["architecture", "authentication", "authentication"]
    },
    {
      "id": "boundary",
      "op": "save",
      "workspaceId": "workspace-a",
      "sessionId": "$session.main-session",
      "type": "discovery",
      "title": "Checkout boundary",
      "content": "The checkout frontend calls the BFF boundary.",
      "tags": ["checkout", "bff"]
    },
    {
      "id": "other-workspace",
      "op": "save",
      "workspaceId": "workspace-b",
      "type": "discovery",
      "title": "Other workspace",
      "content": "This memory must remain isolated from workspace-a."
    },
    {
      "id": "search-auth",
      "op": "search",
      "workspaceId": "workspace-a",
      "query": "authentication checkout",
      "expectedTitles": ["Checkout authentication"]
    },
    {
      "id": "auth-update",
      "op": "save",
      "workspaceId": "workspace-a",
      "type": "decision",
      "title": "Checkout authentication updated",
      "content": "The approved authentication model remains the boundary.",
      "subjectKey": "architecture/checkout/authentication",
      "tags": ["updated", "architecture"]
    },
    {
      "id": "search-old",
      "op": "search",
      "workspaceId": "workspace-a",
      "query": "approved authentication model",
      "expectedTitles": ["Checkout authentication updated"]
    },
    {
      "id": "search-synonym",
      "op": "search",
      "workspaceId": "workspace-a",
      "query": "auth checkout",
      "expectedTitles": ["Checkout authentication updated"]
    },
    {
      "id": "relation",
      "op": "addRelation",
      "sourceMemoryId": "$memory.auth",
      "targetMemoryId": "$memory.boundary",
      "relation": "supports"
    },
    {
      "id": "relation-repeat",
      "op": "addRelation",
      "sourceMemoryId": "$memory.auth",
      "targetMemoryId": "$memory.boundary",
      "relation": "supports"
    },
    {
      "id": "cross-workspace-relation",
      "op": "addRelation",
      "sourceMemoryId": "$memory.auth",
      "targetMemoryId": "$memory.other-workspace",
      "relation": "related",
      "expectError": "Related memories must belong to the same workspace."
    },
    {
      "id": "sensitive",
      "op": "save",
      "workspaceId": "workspace-a",
      "type": "discovery",
      "title": "Runtime configuration",
      "content": "client_secret: 12345678901234567890",
      "expectError": "Sensitive content detected in memory."
    },
    {
      "id": "expired",
      "op": "save",
      "workspaceId": "workspace-a",
      "type": "discovery",
      "title": "Expired rollout",
      "content": "This memory is outside its validity window.",
      "validFrom": "2025-01-01T00:00:00.000Z",
      "expiresAt": "2025-12-31T00:00:00.000Z"
    },
    {
      "id": "lifecycle-before-archive",
      "op": "inspectLifecycle",
      "workspaceId": "workspace-a",
      "expected": {
        "total": 3,
        "expired": 1,
        "byStatus": {
          "active": 3,
          "needs_review": 0,
          "superseded": 0,
          "archived": 0
        }
      }
    },
    {
      "id": "archive-expired",
      "op": "archiveExpired",
      "workspaceId": "workspace-a",
      "expectedCount": 1
    },
    {
      "id": "lifecycle-after-archive",
      "op": "inspectLifecycle",
      "workspaceId": "workspace-a",
      "expected": {
        "total": 3,
        "expired": 1,
        "byStatus": {
          "active": 2,
          "needs_review": 0,
          "superseded": 0,
          "archived": 1
        }
      }
    },
    {
      "id": "reviewable",
      "op": "save",
      "workspaceId": "workspace-a",
      "type": "decision",
      "title": "Reviewable checkout decision",
      "content": "The checkout boundary needs periodic review.",
      "validFrom": "2026-01-01T00:00:00.000Z",
      "reviewAt": "2026-01-10T00:00:00.000Z"
    },
    {
      "id": "due-review",
      "op": "listDueForReview",
      "workspaceId": "workspace-a"
    },
    {
      "id": "review-status",
      "op": "transitionStatus",
      "memoryId": "$memory.reviewable",
      "status": "needs_review"
    },
    {
      "id": "complete-review",
      "op": "completeReview",
      "memoryId": "$memory.reviewable",
      "nextReviewAt": "2026-02-15T12:00:00.000Z"
    },
    {
      "id": "compact-checkout",
      "op": "compact",
      "workspaceId": "workspace-a",
      "memoryIds": ["$memory.auth", "$memory.boundary"],
      "title": "Checkout compact summary",
      "maxChars": 200,
      "archiveSources": false
    },
    {
      "id": "compact-checkout-repeat",
      "op": "compact",
      "workspaceId": "workspace-a",
      "memoryIds": ["$memory.auth", "$memory.boundary"],
      "title": "Checkout compact summary",
      "maxChars": 200,
      "archiveSources": false
    },
    {
      "id": "retention-preview",
      "op": "runRetention",
      "workspaceId": "workspace-a",
      "purgeBefore": "2026-02-01T00:00:00.000Z",
      "dryRun": true
    },
    {
      "id": "retention-execute",
      "op": "runRetention",
      "workspaceId": "workspace-a",
      "purgeBefore": "2026-02-01T00:00:00.000Z",
      "dryRun": false
    },
    {
      "id": "private-key-sensitive",
      "op": "save",
      "workspaceId": "workspace-a",
      "type": "discovery",
      "title": "Private material",
      "content": "-----BEGIN RSA PRIVATE KEY-----",
      "expectError": "Sensitive content detected in memory."
    },
    {
      "id": "compact-and-archive-reviewable",
      "op": "compact",
      "workspaceId": "workspace-a",
      "memoryIds": ["$memory.reviewable"],
      "title": "Reviewed decision summary",
      "maxChars": 200,
      "archiveSources": true
    },
    {
      "id": "finish-session",
      "op": "endSession",
      "sessionId": "$session.main-session",
      "summary": "Captured the authentication and boundary decisions."
    }
  ]
}
